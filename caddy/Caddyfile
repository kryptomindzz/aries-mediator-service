# Listen on all interfaces, default Caddy port
{
    debug
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}
caddy.ziraai.app {

        # This is the pattern that will be used to detect
        # WebSockets
        @websockets {
                header Connection *Upgrade*
                header Upgrade websocket
        }

        # Handle any traffic that matches the `@websockets` pattern
        handle @websockets {
                reverse_proxy http://mediator:3001 {
                        # Increase timeouts for long-lived websocket connections
                        transport http {
                                read_timeout 300s
                                write_timeout 300s
                                dial_timeout 30s
                        }
                        # Add websocket-specific headers
                        header_up X-Real-IP {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                }
        }

        # Handle all other traffic.
        handle {

                reverse_proxy http://mediator:3000
        }

        # What logs should look like.
        log {
                        output stdout
                        # format single_field common_log
                        level ERROR
        }
}

#IP address dynamically set via INTERNAL_IP environment variable
#command: hostname -i
issuer.ziraai.app {
    reverse_proxy http://{$INTERNAL_IP}:9021
}

verifier.ziraai.app {
    reverse_proxy http://{$INTERNAL_IP}:9041
}
api.issuer.ziraai.app {
    reverse_proxy http://{$INTERNAL_IP}:8021
}
api.verifier.ziraai.app {
    reverse_proxy http://{$INTERNAL_IP}:8041
}
#serve static files
home.ziraai.app {
        root * /var/www/html
        file_server {
                hide .git
        }
}
